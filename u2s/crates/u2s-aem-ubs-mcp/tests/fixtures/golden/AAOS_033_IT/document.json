              {
                "bind_ref": null,
                "children": [
                  {
                    "alignment": "Vertical",
                    "bind_ref": null,
                    "colspan": 12,
                    "conditions": [],
                    "dor_colspan": null,
                    "label": {
                      "it": "Il Cliente, dopo avere esaminato e ponderato con attenzione le caratteristiche di ciascuna Linea di Gestione che intende attivare e/o disattivare richiede a UBS Europe SE, Succursale Italia (di seguito «UBS» o la «Banca») di procedere come segue relativamente alle Linee di Gestione del mandato di gestione multilinea indicato in epigrafe: "
                    },
                    "mandatory": false,
                    "name": "RB_IlClienteDopoAvereEsaminatoE_c11845fb",
                    "options": [],
                    "type": "RadioButton",
                    "uuid": "50eb581a-8190-4585-b287-76e3974e2bc2",
