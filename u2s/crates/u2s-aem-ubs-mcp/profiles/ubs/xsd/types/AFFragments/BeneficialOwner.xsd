				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="BOBasicType">
		<xs:complexContent>
			<xs:extension base="BeneficialOwnerType">
				<xs:sequence>
					<xs:element name="ExecutiveRoleOther" type="xs:string" minOccurs="0"/>
