	<xs:complexType name="CardType">
		<xs:sequence>
			<xs:element name="FirstSixDigits" type="xs:string"/>
			<xs:element name="ProtectedNumber1" type="xs:string"/>
			<xs:element name="ProtectedNumber2" type="xs:string" minOccurs="0"/>
			<xs:element name="LastFourDigits" type="xs:string"/>
			<xs:element name="CardNumber" type="xs:string" minOccurs="0"/>
			<xs:element name="CardProduct" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CardMatrixType">
		<xs:sequence>
			<xs:element name="Brand" type="xs:string" minOccurs="0"/>
			<xs:element name="Design" type="xs:string" minOccurs="0"/>
			<xs:element name="Currency" type="xs:string" minOccurs="0"/>
			<xs:element name="SurchargePerMonth" type="xs:string" minOccurs="0"/>
			<xs:element name="MaxLimit" type="xs:decimal" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CardAdditionalServiceType">
		<xs:sequence>
			<xs:element name="KeyClubProgram" type="xs:string"/>
			<xs:element name="TravelInsurance" type="xs:string"/>
			<xs:element name="InsuranceStartDate" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="CardHolderType">
		<xs:complexContent>
			<xs:extension base="IndividualType">
				<xs:sequence>
					<xs:element name="CorrespondenceLanguage" type="xs:string" minOccurs="0"/>
					<xs:element name="PersonalCodeword" type="xs:string" minOccurs="0"/>
