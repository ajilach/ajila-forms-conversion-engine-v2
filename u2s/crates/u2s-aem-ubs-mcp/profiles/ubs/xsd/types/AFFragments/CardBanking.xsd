				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CardBankType">
		<xs:complexContent>
			<xs:extension base="BankType">
				<xs:sequence>
					<xs:element name="ContactPerson" type="xs:string"/>
					<xs:element name="AccountNo" type="xs:string"/>
					<xs:element name="ClearingNo" type="xs:string"/>
					<xs:element ref="IBAN"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CardAddressType">
		<xs:complexContent>
