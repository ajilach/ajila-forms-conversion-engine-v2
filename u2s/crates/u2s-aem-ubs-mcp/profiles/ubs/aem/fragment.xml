<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    {% if css %}css="{{ css }}"{% endif %}
    dorExcludeDescription="true"
    dorExcludeTitle="true"
    {% if dor_exclude or frag_ref is ending_with("affrg_BankingRelationship1") %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    fragRef="{{ frag_ref }}"
    guideNodeClass="guidePanel"
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude or frag_ref is ending_with("affrg_BankingRelationship1") %}summaryExclusion="true"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"
    {% if not visible %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    <layout
        jcr:primaryType="nt:unstructured"
        sling:resourceType="{{ variables.default_layout }}"
        columns="1"
        dorLayoutType="columnar"
        dorNumCols="1"
        nonNavigable="{Boolean}true"
        toolbarPosition="Bottom"/>
    <items
        jcr:primaryType="nt:unstructured"
        sling:resourceType="{{ variables.default_layout }}"/>
    {% if not has_passthrough_rules %}<fd:rules jcr:primaryType="nt:unstructured"/>{% endif %}
    {#  The Initialize rules themselves live in the profile config, because
        `preface.xml` emits the banking one too — see `[variables]` there for
        what each carries and why it must be a single SCRIPTMODEL.

        "Form of address" (salutation) fragments share the word and nothing else:
        they carry no address block, so the address rule would reference fields
        that do not exist. #}
    {% set frag_base = frag_ref | split(pat="/") | last | lower %}
    {#  `field` names the component the rule runs on, and the corpus writes it as
        the component's full guide path -- `this` works at runtime but is not what
        PROBLEM-address-city-country-mandatory reads, and that rule is checked per
        field+event slot. The path is per node, so it is substituted here rather
        than being part of the stored rule. #}
    {% set addr_field = '&quot;field&quot;:&quot;' ~ guide_path ~ '&quot;' %}
    {% if frag_base is ending_with("affrg_addressgeneric1") %}
    <fd:scripts fd:init="{{ variables.address_generic_init | default(value="") | replace(from='&quot;field&quot;:&quot;this&quot;', to=addr_field) }}" jcr:primaryType="nt:unstructured"/>
    {% elif frag_base is containing("address")
        and not frag_base is containing("formofaddress")
        and not frag_base is containing("form_address") %}
    <fd:scripts fd:init="{{ variables.address_init | default(value="") | replace(from='&quot;field&quot;:&quot;this&quot;', to=addr_field) }}" jcr:primaryType="nt:unstructured"/>
    {% elif frag_base is ending_with("affrg_bankingrelationship1") and xfa.formrange_entity | default(value="") == "019" %}
    <fd:scripts fd:init="{{ variables.banking_default_de_init | default(value="") }}" jcr:primaryType="nt:unstructured"/>
    {% else %}
    <fd:scripts jcr:primaryType="nt:unstructured"/>
    {% endif %}
    {{ raw_children }}
</{{ element_name }}>
