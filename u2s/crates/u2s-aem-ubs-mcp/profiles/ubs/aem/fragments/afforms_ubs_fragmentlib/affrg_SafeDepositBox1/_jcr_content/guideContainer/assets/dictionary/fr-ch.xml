    <fd__x003c_p_x003e_Subject-2032087789
        jcr:mixinTypes="[sling:Message]"
        jcr:primaryType="nt:folder"
        sling:key="fd_&lt;p>Subject to mandatory jurisdictions provided by law the exclusive place of jurisdiction for all legal proceedings shall be Zurich or the location of the branch holding the account.&lt;/p>&#xa;"
