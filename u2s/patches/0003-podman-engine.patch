+/// The socket [`DockerLifecycle::connect`] last reached an engine on.
+#[cfg(unix)]
+static CONNECTED_SOCKET: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);
+
+/// Where a Docker or Podman engine's API socket is looked for, in order,
+/// keeping only paths that exist:
+///
+/// 1. `DOCKER_HOST`, then `CONTAINER_HOST` (Podman's own variable), when set
+///    to a `unix://` socket. Set, they are the only candidate: an explicit
+///    choice that does not answer is reported, not silently bypassed.
+/// 2. `/var/run/docker.sock` -- Docker Desktop, or Podman Desktop with
+///    "Docker compatibility" on (its `podman-mac-helper` links it there).
+/// 3. `~/.docker/run/docker.sock` -- Docker Desktop's per-user socket.
+/// 4. A Podman machine's forwarded API socket on macOS:
+///    `$TMPDIR/podman/<machine>-api.sock` (Podman 5), then
+///    `~/.local/share/containers/podman/machine/[<machine>/]podman.sock`
+///    (Podman 4). `podman-machine-default` first.
+/// 5. Rootless and rootful Podman on Linux:
+///    `$XDG_RUNTIME_DIR/podman/podman.sock`, `/run/podman/podman.sock`.
+/// 6. When none of those exists: what `podman machine inspect` reports as
+///    the machine's socket, for a machine whose socket lives anywhere else.
+#[cfg(unix)]
+pub fn engine_sockets() -> Vec<String> {
+    use std::path::{Path, PathBuf};
+
+    for var in ["DOCKER_HOST", "CONTAINER_HOST"] {
+        if let Ok(host) = std::env::var(var)
+            && let Some(path) = host.strip_prefix("unix://")
+        {
+            return vec![path.to_owned()];
+        }
+    }
+
+    let mut paths: Vec<PathBuf> = vec![PathBuf::from("/var/run/docker.sock")];
+    let home = std::env::var_os("HOME").map(PathBuf::from);
+    if let Some(home) = &home {
+        paths.push(home.join(".docker/run/docker.sock"));
+    }
+    paths.extend(sorted_matches(
+        &std::env::temp_dir().join("podman"),
+        |name| name.ends_with("-api.sock"),
+        |dir, name| dir.join(name),
+    ));
+    if let Some(home) = &home {
+        let machines = home.join(".local/share/containers/podman/machine");
+        paths.push(machines.join("podman.sock"));
+        paths.extend(sorted_matches(
+            &machines,
+            |_| true,
+            |dir, name| dir.join(name).join("podman.sock"),
+        ));
+    }
+    if let Some(runtime) = std::env::var_os("XDG_RUNTIME_DIR") {
+        paths.push(PathBuf::from(runtime).join("podman/podman.sock"));
+    }
+    paths.push(PathBuf::from("/run/podman/podman.sock"));
+
+    let mut sockets: Vec<String> = Vec::new();
+    for path in paths {
+        if Path::new(&path).exists() {
+            let path = path.to_string_lossy().into_owned();
+            if !sockets.contains(&path) {
+                sockets.push(path);
+            }
+        }
+    }
+    // Starting a process is slow, so only when nothing above exists.
+    if sockets.is_empty()
+        && let Some(socket) = podman_cli_socket()
+        && Path::new(&socket).exists()
+    {
+        sockets.push(socket);
+    }
+    sockets
+}
