+/// Entries of `dir` whose name passes `keep`, mapped by `to_path`, with
+/// Podman's default machine first and the rest by name.
+#[cfg(unix)]
+fn sorted_matches(
+    dir: &std::path::Path,
+    keep: impl Fn(&str) -> bool,
+    to_path: impl Fn(&std::path::Path, &str) -> std::path::PathBuf,
+) -> Vec<std::path::PathBuf> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = entries
+        .filter_map(|e| e.ok())
+        .map(|e| e.file_name().to_string_lossy().into_owned())
+        .filter(|name| keep(name))
+        .collect();
+    names.sort_by_key(|name| (!name.starts_with("podman-machine-default"), name.clone()));
+    names.iter().map(|name| to_path(dir, name)).collect()
+}
+
+/// The API socket `podman machine inspect` reports for the running machine.
+/// An app started from Finder does not inherit the shell's `PATH`, so the
+/// usual install locations are tried as well.
+#[cfg(unix)]
+fn podman_cli_socket() -> Option<String> {
+    let binaries = [
+        "podman",
+        "/opt/podman/bin/podman",
+        "/opt/homebrew/bin/podman",
+        "/usr/local/bin/podman",
+    ];
+    for podman in binaries {
+        let Ok(output) = std::process::Command::new(podman)
+            .args([
+                "machine",
+                "inspect",
+                "--format",
+                "{{.ConnectionInfo.PodmanSocket.Path}}",
+            ])
+            .stdin(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .output()
+        else {
+            continue;
+        };
+        if !output.status.success() {
+            continue;
+        }
+        let socket = String::from_utf8_lossy(&output.stdout)
+            .lines()
+            .map(str::trim)
+            .find(|line| !line.is_empty() && *line != "<no value>")
+            .map(str::to_owned);
+        if socket.is_some() {
+            return socket;
+        }
+    }
+    None
+}
