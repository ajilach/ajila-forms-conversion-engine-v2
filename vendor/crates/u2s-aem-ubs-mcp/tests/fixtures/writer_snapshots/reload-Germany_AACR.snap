                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <textdraw_32a277cc194e40c7a5d1935c9fe11a50 _value="<p>The lists of Authorized Users as well as the technical and administrative contact partners supplement any already existing lists in connection with the use of UBS KeyPort (EBICS). As such, entries on already existing lists shall remain valid unless expressly revoked in writing.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheListsOfAuthorizedUsersAs_f75191b1" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_c037e9e6010d42bfb4fa3eaca6930ded _value="<p><b>This also applies in particular in the event of changes to the underlying power of attorney (e.g. &quot;Authorized signatures&quot;).</b></p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ThisAlsoAppliesInParticularIn_6867a372" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
