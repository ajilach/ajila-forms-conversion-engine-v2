                      <textdraw_cc007847f5f45072979fa19698a19a7e _value="<p>Payment orders issued by a technical user with sole signature (E) rights will be processed by UBS immediately. For the processing of orders placed by a technical user with the transport signature (T) access right, approval from an additional individual with EBICS access authorization (pursuant to section 2) must be obtained.</p>\n" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_PaymentOrder_1780480901632" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
