                  <textdraw_81e314759ddc40f281ed02162380521c _value="<p>The following individuals (&quot;Authorized Users&quot;) shall be authorized to process transactions in accordance with the following account access rights using the assigned signature right (&quot;ES&quot;). Unless specified otherwise in the following authorization, the Authorized User listed below shall be authorized to use UBS KeyPort (EBICS) analogously to his powers <b>in accordance with the underlying power of attorney</b> (e.g. &quot;Authorized signatures&quot;), to the extent that such use is technically feasible and is offered. The Client must immediately inform UBS of any changes to these Authorized Users.</p>\n" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheFollowingIndividuals_ae7b1a1c" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
