                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <titledraw_993fda0843a04b24bbfb27d7ba182b3a _value="<p>Data di efficacia della richiesta di variazione linee</p>\n" css="stepTitle" dorExclusion="true" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="2" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_DataDiEfficaciaDellaRichiesta_628ea418" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" summaryExclusion="true" textIsRich="true">
              <panel_31497aa8b0225d658c5e23765cc14669 dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_StaticText_fd3f5ebe" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <textdraw_45d9609e205b4ea8927808cad3fde179 _value="<p>La presente Richiesta di Variazione Linee del Cliente avrà effetto dal giorno della sottoscrizione.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_LaPresenteRichiestaDi_2e6aa7e5" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_cb3a6a2394b344aeaf546595616b48a2 _value="<p>In ogni caso, si avverte il Cliente che in considerazione dei tempi tecnici necessari le operazioni di investimento e disinvestimento potrebbero richiedere per l&#39;attuazione un termine massimo di 30 giorni solari dal giorno della disponibilità effettiva della liquidità da parte della Banca (fermo, comunque, restando il rispetto di eventuali soglie minime di conferimento).</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_InOgniCasoSiAvverteIlCliente_e8abdc12" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
