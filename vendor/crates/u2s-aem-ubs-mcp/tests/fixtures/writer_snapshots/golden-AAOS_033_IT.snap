<vaultfs version="1.1">
  <aggregates >
    <aggregate title="File Aggregate" type="file">
    <aggregate title="File/Folder Aggregate" type="filefolder">
    <aggregate title="Node Type Aggregate" type="nodetype">
    <aggregate title="Full Coverage Aggregate" type="full">
      <matches >
        <include nodeType="rep:AccessControl" respectSupertype="true">
        <include nodeType="rep:Policy" respectSupertype="true">
        <include nodeType="cq:Widget" respectSupertype="true">
        <include nodeType="cq:EditConfig" respectSupertype="true">
        <include nodeType="cq:WorkflowModel" respectSupertype="true">
        <include nodeType="vlt:FullCoverage" respectSupertype="true">
        <include nodeType="mix:language" respectSupertype="true">
        <include nodeType="sling:OsgiConfig" respectSupertype="true">
    <aggregate title="Folder Aggregate" type="generic">
      <matches >
        <include nodeType="nt:folder" respectSupertype="true">
      <contains >
        <exclude isNode="true">
    <aggregate isDefault="true" title="Default Aggregator" type="generic">
      <matches >
      <contains >
        <exclude nodeType="nt:hierarchyNode" respectSupertype="true">
  <handlers >
    <handler type="folder">
    <handler type="file">
    <handler type="nodetype">
    <handler type="generic">
