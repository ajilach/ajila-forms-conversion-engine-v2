          <panel_3e72e0cc48364aaca6c8c0888d25b5bc dorExcludeDescription="true" dorExcludeTitle="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_Dichiarazioni_098bbfdb" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
            <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
              <panel_title_3e72e0cc48364aaca6c8c0888d25b5bc dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" jcr:title="Dichiarazioni" name="PN_Dichiarazioni_098bbfdbTitle" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <layout columns="1" dorLayoutType="columnar" jcr:primaryType="nt:unstructured" nonNavigable="{Boolean}true" sling:resourceType="fd/af/layouts/gridFluidLayout2" toolbarPosition="Bottom">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <titledraw_3e72e0cc48364aaca6c8c0888d25b5bc _value="<p>Dichiarazioni</p>\n" css="stepTitle" dorExclusion="true" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="2" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_Dichiarazioni_098bbfdb" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" summaryExclusion="true" textIsRich="true">
              <panel_cf5cc7ff9f01539f8c75c902b39ff391 dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_StaticText_86699db4" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <textdraw_cf6d7b9edcf142d68fb370d1679e7ad2 _value="<p>Con riferimento al suindicato mandato di gestione multilinea, nonché al Contratto Unico per la Prestazione di Servizi di Investimento ed alla Richiesta di Attivazione del Servizio di Gestione, il Cliente dichiara: </p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ConRiferimentoAlSuindicato_55e68da9" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_5a6c4d3259c045acabd90eec2a98db1c _value="<ul style=\"list-style-type: \"\\2013\";\"><li>di essere consapevole di tutti i rischi connessi a qualsiasi variazione contrattuale e che intende procedere ai sensi e per gli effetti della presente Richiesta di Variazione Linee; </li><li>di essere consapevole del fatto che la presente Richiesta di Variazione Linee può essere sottoscritta, se tale possibilità è resa disponibile da UBS, mediante il servizio E-Signature e che, in tal caso, la Banca utilizza una apposita sezione del servizio Mailbox per la consegna dei seguenti documenti: <ol style=\"list-style-type: lower-roman;\"><li>documentazione informativa precontrattuale prevista dalla normativa di riferimento; </li><li>la presente Richiesta di Variazione Linee in formato elettronico da sottoscrivere mediante il servizio E-Signature; </li><li>la presente Richiesta di Variazione Linee in formato elettronico sottoscritta mediante il servizio E-Signature; </li><li>eventuale comunicazione con cui la Banca conferma l&#39;attivazione dei servizi in relazione alla presente Richiesta di Variazione Linee;</li></ol></li><li>di essere altresì consapevole del fatto che la presente Richiesta di Variazione Linee può essere sottoscritta, se tale possibilità è resa disponibile da UBS, (i) mediante firma elettronica qualificata (o altra tipologia di firma idonea a integrare il requisito della forma scritta ai sensi della normativa tempo per tempo applicabile) fornita da un provider terzo qualificato ai sensi del Regolamento EIDAS oppure (ii) mediante firma digitale, firma elettronica qualificata, firma elettronica avanzata o altra tipologia di firma idonea a integrare il requisito della forma scritta ai sensi della normativa tempo per tempo applicabile messa a disposizione del Cliente da UBS, anche tramite provider terzi, secondo le modalità e la procedura tempo per tempo comunicate dalla Banca.</li></ul>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_DiEssereConsapevoleDiTuttiI_c3f04dc1" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                <layout columns="1" dorLayoutType="columnar" jcr:primaryType="nt:unstructured" nonNavigable="{Boolean}true" sling:resourceType="fd/af/layouts/gridFluidLayout2" toolbarPosition="Bottom">
