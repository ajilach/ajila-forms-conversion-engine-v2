          <panel_2f5ee84fa9704e0b8bb712a25c1046e2 dorExcludeDescription="true" dorExcludeTitle="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_DisattivazioneDisinvestimento_802781de" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
