== schema
<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="../AFSimpleTypeElements/AFSimpleElements.xsd"/>
  <xs:include schemaLocation="../AFFragments/ContractualPartnerGeneric.xsd"/>
  <xs:include schemaLocation="../AFFragments/PartnerToPartnerGeneric.xsd"/>
  <xs:include schemaLocation="../AFFragments/Signature.xsd"/>

  <xs:element name="UBSAF_AAOS">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FormConfigurator" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Tipo" type="xs:string" minOccurs="0"/>
              <xs:element name="FIMSignatureVerification" type="xs:string" minOccurs="0"/>
              <xs:element ref="AccountHolder" minOccurs="0" maxOccurs="50"/>
              <xs:element name="Name" type="xs:string" minOccurs="0"/>
              <xs:element ref="AuthRep" minOccurs="0" maxOccurs="50"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="RichiestaDiVariazioneLineeDiGestioneDelMandatoDiGestioneMultilinea" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="RCPDf94f111" minOccurs="0" maxOccurs="50">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="IlClienteDopoAvereEsaminatoEPonderatoConAttenzioneLeCaratteristicheDiCiascunaLineaDiGestioneCheIntendeAttivareEOrODisattivareRichiedeAUBSEuropeSESuccursaleItaliaDiSeguitoUBSOLaBancaDiProcedereComeSegueRelativamenteAlleLineeDiGestioneDelMandatoDiGestioneMultilineaIndicatoInEpigrafe" type="xs:string" minOccurs="0"/>
                    <xs:element name="éNellaRichiestaDiAttivazioneDelServizioDiGestioneGiàSottoscrittiDalClienteInSegnoDiAccettazione" type="xs:string" minOccurs="0"/>
                    <xs:element name="Rb2" type="xs:string" minOccurs="0"/>
                    <xs:element name="Rb3" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="ConferimentiEOrODisinvestimentiParziali" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="PerQuantoRiguardaIConferimentiIlClienteSceglieEConferma" type="xs:string" minOccurs="0"/>
              <xs:element name="Contribution2" type="xs:string" minOccurs="0"/>
              <xs:element name="Contribution3" type="xs:string" minOccurs="0"/>
              <xs:element name="DiEffettuareConferimentiAggiuntiviCheDovrannoEssereRipartitiComeSegue" type="xs:string" minOccurs="0"/>
              <xs:element name="Contribution4" type="xs:string" minOccurs="0"/>
              <xs:element name="DiEffettuareDisinvestimentiParzialiCheDovrannoEssereRipartitiComeSegue" type="xs:string" minOccurs="0"/>
              <xs:element name="Contribution5" type="xs:string" minOccurs="0"/>
              <xs:element name="Altro" type="xs:string" minOccurs="0"/>
              <xs:element name="Contribution6" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="FirmaOrE" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="AccountHolderSignature" type="SignatureType" minOccurs="0" maxOccurs="50"/>
              <xs:element name="AccountHolderSignature2" type="SignatureType" minOccurs="0" maxOccurs="50"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>

