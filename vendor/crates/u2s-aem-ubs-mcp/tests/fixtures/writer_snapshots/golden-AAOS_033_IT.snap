                  <titledraw_2f5ee84fa9704e0b8bb712a25c1046e2 _value="<p>Disattivazione Disinvestimento</p>\n" css="stepTitle" dorExclusion="true" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="2" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_DisattivazioneDisinvestimento_802781de" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" summaryExclusion="true" textIsRich="true">
              <panel_b354ca830c6a5fd8a51cef7171b0712c dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_StaticText_3082ec55" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <textdraw_5f5524a94fca44dbbb6df67c473d3f61 _value="<p>Il Cliente autorizza la Banca, in esecuzione del mandato di gestione, ad aprire o chiudere per conto del Cliente conti correnti e/o conti di custodia ed amministrazione titoli accessori e funzionali a ciascuna Linea di Gestione. Tali conti, che saranno regolati dalle relative Condizioni generali di Contratto contenute nel «Contratto Unico per la Prestazione di Servizi di Investimento», sono da intendersi comunque tutti facenti capo al mandato di gestione multi linea.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_IlClienteAutorizzaLaBancaIn_0f21bb8b" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
