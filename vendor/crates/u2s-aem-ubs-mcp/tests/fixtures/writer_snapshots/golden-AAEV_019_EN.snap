== package jcr_root/content/forms/af/afforms_germany_all/af_aa/AF_AAEV/_jcr_content/guideContainer/assets/dictionary/de-ch.xml
"fd_<p>By clicking on \"Preview\", you can review your document before submission.</p><p>After clicking \"Submit\", you will no longer be able to edit the document and the PDF will be created for signing.</p>" = "<p>Durch Klicken auf \"Vorschau\" können Sie Ihr Dokument vor dem Absenden überprüfen.</p><p>Nach dem Klicken auf \"Absenden\" können Sie das Dokument nicht mehr bearbeiten und das PDF wird zur Unterschrift erstellt.</p>"
"fd_<p>The form could not be sent. Please try again later.</p>" = "<p>Das Formular konnte nicht gesendet werden. Bitte versuchen Sie es später erneut.</p>"
"fd_Add" = "Hinzufügen"
"fd_Back" = "Zurück"
"fd_Company" = "Firma"
"fd_For internal bank use only" = "Nur für den internen Bankgebrauch"
"fd_Next" = "Weiter"
"fd_Please enter a valid email address (e.g., max.muster@beispiel.ch)." = "Bitte geben Sie eine gültige E-Mail-Adresse ein (z. B. max.muster@beispiel.ch)."
"fd_Please enter a valid phone number incl. country code (e.g., +41)." = "Bitte geben Sie eine gültige Telefonnummer einschließlich Ländervorwahl (z. B. +41) ein."
"fd_Preview" = "Vorschau"
"fd_Save Progress" = "Fortschritt speichern"
"fd_Signature(s)" = "Unterschrift(en)"
"fd_Signature(s) verified / Signed in my presence" = "Unterschrift(en) geprüft / in meiner Gegenwart unterzeichnet"
"fd_Submission failed" = "Übermittlung fehlgeschlagen"
"fd_Submit" = "Absenden"
"fd_Summary" = "Zusammenfassung"
"fd_Summary of form information" = "Zusammenfassung der Formulardaten"
"fd_Thank you for submitting the form." = "Vielen Dank für das Einreichen des Formulars."
