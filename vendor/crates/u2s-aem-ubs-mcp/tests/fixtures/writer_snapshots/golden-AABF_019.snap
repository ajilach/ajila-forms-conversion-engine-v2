"fd_1st time" = "Erstmals"
"fd_<p>(day, month, year)</p>" = "<p>(Tag, Monat, Jahr)</p>"
"fd_<p><b>New editions and requests for changes </b>must reach UBS Europe SE <b>at least 1 business day before execution, </b>otherwise timely execution can no longer be guaranteed.</p>" = "<p><b>Neuerfassung und Änderungswünsche </b>müssen <b>spätestens 1 Bankwerktag </b>vor Fälligkeit bei UBS Europe SE eingegangen sein, andernfalls kann die fristgerechte Ausführung des Auftrages nicht gewährleistet werden.</p>"
