== schema
<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="../AFSimpleTypeElements/AFSimpleElements.xsd"/>
  <xs:include schemaLocation="../AFFragments/IBAN.xsd"/>
  <xs:include schemaLocation="../AFFragments/LegalEntity.xsd"/>
  <xs:include schemaLocation="../AFFragments/Individual.xsd"/>
  <xs:include schemaLocation="../AFFragments/ContractualPartnerGeneric.xsd"/>
  <xs:include schemaLocation="../AFFragments/PartnerToPartnerGeneric.xsd"/>
  <xs:include schemaLocation="../AFFragments/Address.xsd"/>
  <xs:include schemaLocation="../AFFragments/Signature.xsd"/>

  <xs:element name="UBSAF_AABF">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FormConfigurator" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="FormularAdressat" type="xs:string" minOccurs="0"/>
              <xs:element ref="IBANumber" minOccurs="0"/>
              <xs:element ref="Company" minOccurs="0"/>
              <xs:element ref="Company2" minOccurs="0"/>
              <xs:element ref="IndividualBasic" minOccurs="0" maxOccurs="50"/>
              <xs:element ref="AccountHolder" minOccurs="0" maxOccurs="50"/>
              <xs:element ref="AuthRep" minOccurs="0" maxOccurs="50"/>
              <xs:element ref="Company3" minOccurs="0"/>
              <xs:element ref="AuthRep2" minOccurs="0" maxOccurs="50"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="StandingOrder" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="StandingOrder" type="xs:string" minOccurs="0"/>
              <xs:element name="Currency" type="xs:string" minOccurs="0"/>
              <xs:element name="Amount" type="xs:string" minOccurs="0"/>
              <xs:element name="Currency2" type="xs:string" minOccurs="0"/>
              <xs:element name="PreviousAmount" type="xs:string" minOccurs="0"/>
              <xs:element name="NewAmount" type="xs:string" minOccurs="0"/>
              <xs:element name="OrderNo" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Execution" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Execution" type="xs:string" minOccurs="0"/>
              <xs:element name="ExecutionDay" type="xs:string" minOccurs="0"/>
              <xs:element name="Rb3" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb4" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb5" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb6" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb7" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb8" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb9" type="xs:date" minOccurs="0"/>
              <xs:element name="Rb31" type="xs:string" minOccurs="0"/>
              <xs:element name="1stTime" type="xs:string" minOccurs="0"/>
              <xs:element name="Month" type="xs:string" minOccurs="0"/>
              <xs:element name="Year" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate" type="xs:string" minOccurs="0"/>
              <xs:element name="MonthYear" type="xs:date" minOccurs="0"/>
              <xs:element name="Month2" type="xs:string" minOccurs="0"/>
              <xs:element name="Year2" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate2" type="xs:string" minOccurs="0"/>
              <xs:element name="MonthYear2" type="xs:date" minOccurs="0"/>
              <xs:element name="MonthYear3" type="xs:date" minOccurs="0"/>
              <xs:element name="Month3" type="xs:string" minOccurs="0"/>
              <xs:element name="Year3" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate3" type="xs:string" minOccurs="0"/>
              <xs:element name="MonthYear4" type="xs:date" minOccurs="0"/>
              <xs:element name="Month4" type="xs:string" minOccurs="0"/>
              <xs:element name="Year4" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate4" type="xs:string" minOccurs="0"/>
              <xs:element name="BlockOrder" type="xs:string" minOccurs="0"/>
              <xs:element name="From" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupTo" type="xs:string" minOccurs="0"/>
              <xs:element name="To" type="xs:date" minOccurs="0"/>
              <xs:element name="IfExecutionDayOverlapsWeekendOrHoliday" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Beneficiary" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="LastNameFirstNameSOrCompany" type="xs:string" minOccurs="0"/>
              <xs:element ref="Address" minOccurs="0"/>
              <xs:element ref="IBAN" minOccurs="0"/>
              <xs:element name="PurposeOfPayment" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="BankOfBeneficiary" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
