"fd_1st time" = "Erstmals"
"fd_<p>(day, month, year)</p>" = "<p>(Tag, Monat, Jahr)</p>"
"fd_<p><b>New editions and requests for changes </b>must reach UBS Europe SE <b>at least 1 business day before execution, </b>otherwise timely execution can no longer be guaranteed.</p>" = "<p><b>Neuerfassung und Änderungswünsche </b>müssen <b>spätestens 1 Bankwerktag </b>vor Fälligkeit bei UBS Europe SE eingegangen sein, andernfalls kann die fristgerechte Ausführung des Auftrages nicht gewährleistet werden.</p>"
"fd_<p>All costs to be borne by the:</p>" = "<p>Alle Kosten zu Lasten:</p>"
"fd_<p>Authorized representative(s)</p>" = "<p>Vertretungsberechtigte(r)</p>"
"fd_<p>Bank of beneficiary</p>" = "<p>Bank des Begünstigten</p>"
"fd_<p>Beneficiary</p>" = "<p>Begünstigter</p>"
"fd_<p>By clicking on \"Preview\", you can review your document before submission.</p><p>After clicking \"Submit\", you will no longer be able to edit the document and the PDF will be created for signing.</p>" = "<p>Durch Klicken auf \"Vorschau\" können Sie Ihr Dokument vor dem Absenden überprüfen.</p><p>Nach dem Klicken auf \"Absenden\" können Sie das Dokument nicht mehr bearbeiten und das PDF wird zur Unterschrift erstellt.</p>"
"fd_<p>Costs abroad</p>" = "<p>Kosten Ausland</p>"
"fd_<p>Costs</p>" = "<p>Kosten</p>"
"fd_<p>Execution day</p>" = "<p>Ausführungstag</p>"
"fd_<p>Execution</p>" = "<p>Ausführung</p>"
