            <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
              <textdraw_273726065e084211b8ea76a31b0c6856 _value="<p>Il Cliente prende atto e accetta che UBS può affidarsi alle sue dichiarazioni riportate nella presente fino a quando il Cliente non farà pervenire a UBS comunicazioni scritte in senso contrario. UBS raccomanda al Cliente di rivolgersi al proprio contabile, consulente legale o fiscale indipendente, a seconda dei casi, per garantire la correttezza della dichiarazione riportata nella presente. </p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_Cliente" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                <fd:rules jcr:primaryType="nt:unstructured">
