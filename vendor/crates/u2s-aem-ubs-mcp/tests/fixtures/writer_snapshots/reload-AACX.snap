            <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
              <radiobutton_9bdc475b040550e281ef593ffb93dd72 alignment="vertical" css="widget_ajila_forms_radiobutton" dorFieldStyling="Default" guideNodeClass="guideRadioButton" isTitleRichText="true" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" jcr:title="<p><b>Istruzioni</b></p><p>Effettuare una delle due dichiarazioni riportate sotto contrassegnando la casella appropriata.</p>" mandatory="false" name="RB_Istruzioni" options="[0=<p><b>Non-US Person:&nbsp;</b>Con la presente il Cliente dichiara di non rientrare in alcuna delle Categorie di US Person di cui alle Definizioni.</p>,1=<p><b>US Person:</b>&nbsp;Con la presente il Cliente dichiara di rientrare in una o più delle Categorie di US Person di cui alle Definizioni.</p>]" richTextOptions="true" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/radiobutton" textIsRich="[true,true]">
