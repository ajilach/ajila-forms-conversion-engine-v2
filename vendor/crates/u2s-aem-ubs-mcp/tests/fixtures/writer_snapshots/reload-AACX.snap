                                        <fd:scripts fd:init="[{\"script\":{\"content\":\"var metadata = window.forms.ubs.getFormMetadata();\\\\nvar errMsg = \\\\\"Field not filled in expected format.\\\\\";\\\\nif(metadata.language == \\\\\"de\\\\\"){\\\\n  errMsg = \\\\\"Feld wurde nicht im erwarteten Format ausgefüllt.\\\\\";\\\\n} else if(metadata.language == \\\\\"fr\\\\\"){\\\\n  errMsg = \\\\\"Champ non renseigné dans le format attendu.\\\\\";\\\\n} else if(metadata.language == \\\\\"it\\\\\"){\\\\n  errMsg = \\\\\"Campo non compilato nel formato previsto.\\\\\";\\\\n} else if(metadata.language == \\\\\"es\\\\\"){\\\\n  errMsg = \\\\\"El campo no se ha rellenado en el formato esperado.\\\\\";\\\\n}\\\\nthis.TXT_LastName.validateExpMessage = errMsg;\\\\nthis.TXT_FirstName.validateExpMessage = errMsg;\"\\,\"event\":\"Initialize\"\\,\"field\":\"guide.guideRootPanel.PN_Name_Individual\"}\\,\"nodeName\":\"SCRIPTMODEL\"\\,\"version\":1\\,\"enabled\":true}]" jcr:primaryType="nt:unstructured">
