                  <textdraw_e69e06fb789c4af1a02d4958a46fe76b _value="<p>Questa è una dichiarazione indirizzata a UBS Europe SE, Succursale Italia («UBS») al fine di identificare correttamente lo status del Cliente in relazione ai Servizi titoli forniti da UBS. UBS è un&#39;entità <b>non </b>registrata presso la SEC o la FINRA a qualsiasi titolo. <b>I termini in maiuscolo sono definiti nella sezione Definizioni.</b></p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_QuestaUnaDichiarazione" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
