                  <panel_4bc1856ae5195b3ab249d1b7c266c738 dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" jcr:title="Definizioni" name="PN_DefinizioniTitle" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                    <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                      <titledraw_3e8b4710e64652cb9dd5a22b4a999327 _value="<p>Definizioni</p>\n" css="stepTitle" dorExclusion="true" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="2" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_Dati" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" summaryExclusion="true" textIsRich="true">
                        <cq:responsive jcr:primaryType="nt:unstructured">
                          <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                    <layout columns="1" dorLayoutType="columnar" jcr:primaryType="nt:unstructured" nonNavigable="{Boolean}true" sling:resourceType="fd/af/layouts/gridFluidLayout2" toolbarPosition="Bottom">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <panel_0ef5625274c359a2ba88844f754d98b2 dorExcludeDescription="true" dorExcludeTitle="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_Legge" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                    <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                      <panel_20d47037fa2c59a7b1d5930af655be6f dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_StaticText_3fe6d454" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                        <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                          <textdraw_9a255979e9005e3c914b36e26eacf691 _value="<ul>\n<li><b></b> <b>«Legge» </b>indica il Securities Act statunitense del 1933 con successive modifiche.</li>\n<li><b></b> <b>«FINRA» </b>indica la Financial Industry Regulatory Authority statunitense.</li>\n<li><b></b> <b>«SEC» </b>indica la Securities and Exchange Commission statunitense.</li>\n<li><b></b> <b>«Servizi di esecuzione titoli» </b>indica servizi che consistono in (a) sollecitazioni, acquisti, vendite, scambi e riscatti, tra l'altro, di azioni, obbligazioni, fondi comuni, altri contratti d'investimento , retribuzione per transazione, e (b) qualsiasi comunicazione o attività in merito.</li>\n<li><b></b> <b>«Servizi titoli» </b>indica Servizi di esecuzione titoli e la fornitura di Consulenza relativa a titoli.</li>\n<li><b>«Consulenza relativa a titoli» </b>indica:<ul>\n<li>la fornitura di servizi discrezionali di asset management;</li>\n<li>comunicazioni in merito a<ul>\n<li>l'opportunità di acquistare, vendere o detenere un titolo specifico oppure il suo valore (comprese partecipazioni a fondi di investimento),</li>\n<li>titoli in generale (comprese partecipazioni a fondi di investimento),</li>\n<li>tendenze di mercato,</li>\n<li>asset allocation,</li>\n<li>i vantaggi di investire in titoli rispetto ad altri tipi di investimento (ad es. immobiliare o monete), oppure</li>\n<li>selezione o mantenimento di altri consulenti di investimento; e</li>\n</ul>\n</li>\n<li>la fornitura di strumenti elettronici che rendono accessibili servizi o comunicazioni.</li>\n<li><b></b> Le seguenti informazioni non costituiscono di per sé una Consulenza relativa a titoli: dati reali e storici su conti (estratti conto compresi), conferme di transazioni e comunicazioni relative a istruzioni per operazioni in titoli.</li>\n</ul>\n</li>\n<li><b>«Stati Uniti»&nbsp;</b>o&nbsp;<b>«USA»&nbsp;</b>indicano gli Stati Uniti d'America, i suoi Stati, il District di Columbia, Porto Rico e le Isole Vergini americane e qualsiasi altro territorio o possedimenti del governo degli Stati Uniti, o enclave del governo degli Stati Uniti, le sue agenzie o i suoi enti incaricati.&nbsp;</li>\n<li><b></b> <b>«US Person» </b>indica una persona che rientra in una qualsiasi delle Categorie di US Person di cui sotto.</li>\n<li><b>«Categorie di US Person»&nbsp;</b>indica le categorie di «US Person» di cui sotto:&nbsp;<ul>\n<li>qualsiasi persona fisica domiciliata negli USA;</li>\n<li>qualsiasi eredità il cui esecutore o amministratore è una US Person, tranne se l'eredità della quale un fiduciario professionista che funge da esecutore o amministratore è una US Person se: (a) un esecutore o amministratore dell'eredità che non è una US Person detiene la discrezionalità sugli investimenti, piena o condivisa, in relazione ai beni patrimoniali dell'eredità e (b) l'eredità è soggetta ad una legislazione non stunitense;</li>\n<li>qualsiasi trust di cui un trustee è una US Person, diverso da un trust rispetto al quale un fiduciario professionista che funge da trustee è una US Person se un trustee che non è una US Person detiene la discrezionalità sugli investimenti, piena o condivisa, in relazione ai beni del trust e nessun beneficiario del trust (e nessun settlor se il trust è revocabile) è una US Person;</li>\n<li>qualsiasi persona giuridica (società anonima, società a garanzia limitata, società in nome collettivo, società in accomandita semplice, società in accomandita per azioni o altra persona giuridica) organizzata ai sensi del diritto degli Stati Uniti;&nbsp;</li>\n<li>qualsiasi agenzia e succursale negli USA, di una persona giuridica non statunitense;&nbsp;</li>\n<li>qualsiasi conto non discrezionale o simile (ad eccezione di un'eredità o un trust) detenuto da un intermediario o altro fiduciario a beneficio o per conto di una US Person;&nbsp;</li>\n<li>qualsiasi conto discrezionale o simile (ad eccezione di un'eredità o un trust) detenuto da un intermediario o altro fiduciario organizzato o costituito negli USA oppure (se una persona fisica) che è domiciliata negli USA, ad eccezione di un conto discrezionale o simile (ad eccezione di un'eredità o un trust) detenuto a beneficio o per conto di una Non-US Person da un intermediario o altro fiduciario professionista organizzato o costituito negli USA oppure (se una persona fisica) domiciliato negli USA;&nbsp;</li>\n<li>qualsiasi conto discrezionale o simile detenuto a beneficio di una US Person da UBS o qualsiasi affiliata UBS non organizzata o costituita negli USA oppure (se una persona fisica) non domiciliata negli USA;</li>\n<li>qualsiasi persona giuridica (società anonima, società a responsabilità limitata, società in nome collettivo, società in accomandita semplice, società in accomandita per azioni o qualsiasi altra persona giuridica) organizzata o costituita ai sensi del diritto di uno Stato diverso dagli USA e costituita da una US Person principalmente con lo scopo di investire in titoli non registrati ai sensi della Legge, fatto salvo il caso in cui sia organizzata o costituita e detenuta da investitori accreditati (secondo la definizione di cui alla Regola 501(a) della Legge) che non sono persone fisiche, eredità o trust;</li>\n<li>qualsiasi trust, entità o altra struttura costituita con lo scopo di consentire a una US Person di ottenere i benefici diretti o indiretti dei Servizi titoli di UBS; oppure&nbsp;</li>\n<li>qualsiasi società anonima, società a responsabilità limitata, società in nome collettivo, società in accomandita semplice, società in accomandita per azioni o qualsiasi altra persona giuridica organizzata o costituita ai sensi del diritto di uno Stato diverso dagli USA: (a) che opera principalmente nell'investimento in titoli e (b) di cui il 100% delle azioni o dei diritti di voto è detenuto, direttamente o indirettamente, da US Persons.</li>\n</ul>\n</li>\n</ul>\n" css="stepTitle" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_LeggeIndicaIlSecuritiesAct" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                            <fd:rules jcr:primaryType="nt:unstructured">
                            <cq:responsive jcr:primaryType="nt:unstructured">
                              <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                          <textdraw_d52f7cf03c585d26ac6612e70901a5ca _value="<p>Nonostante i precedenti punti (i) – (xi), non sono US Person:</p>\n<ul>\n<li>un piano di remunerazione per collaboratori costituito e amministrato ai sensi del diritto di uno Stato diverso dagli USA così come delle pratiche abituali e della documentazione di tale Stato;&nbsp;</li>\n<li>qualsiasi agenzia o sede di una US Person ubicata al di fuori degli USA se: (1) l'agenzia o la sede opera per valide ragioni commerciali e (2) l'agenzia o la sede opera nel settore assicurativo o bancario ed è soggetta ad una regolamentazione, rispettivamente assicurativa o bancaria, sostanziale nella giurisdizione in cui è ubicata.</li>\n</ul>\n" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_NonostanteIPrecedentiPuntiIXi" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                            <fd:rules jcr:primaryType="nt:unstructured">
                            <cq:responsive jcr:primaryType="nt:unstructured">
                              <default jcr:primaryType="nt:unstructured" offset="0" width="12">
