                  <default jcr:primaryType="nt:unstructured" offset="0" width="12">
              <textdraw_a6dd001111c1409bb8de0321482fceed _value="<p>Letto, confermato e sottoscritto. </p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_Letto" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
