          <panel_9efb20320c164947a390af887a323e27 dorExcludeDescription="true" dorExcludeTitle="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_Authorization_a76f6e2e" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
            <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
              <panel_f4f7fa00500f5421b5bdc289c4cd04a0 dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" jcr:title="Authorization" name="PN_Authorization_a76f6e2eTitle" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <titledraw_737253d18e4c58279ec62a1b8bb00185 _value="<p>Authorization</p>\n" css="stepTitle" dorExclusion="true" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="2" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_Authorization_a76f6e2e" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" summaryExclusion="true" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                <layout columns="1" dorLayoutType="columnar" jcr:primaryType="nt:unstructured" nonNavigable="{Boolean}true" sling:resourceType="fd/af/layouts/gridFluidLayout2" toolbarPosition="Bottom">
                <cq:responsive jcr:primaryType="nt:unstructured">
                  <default jcr:primaryType="nt:unstructured" offset="0" width="12">
              <panel_272a9594a9985e689ef72ff67dc46fe5 dorExcludeDescription="true" dorFieldStyling="Default" guideNodeClass="guidePanel" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="PN_StaticText_925a83fb" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel" textIsRich="true" validateOnStepCompletion="{Boolean}false">
                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <titledraw_d9871123830543ef8d13f6dad29f58eb _value="<p>1. Disclosure of information</p>" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_1DisclosureOfInformation_ff7f7841" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_795bfdc9bc7346a081806141fb02a9fd _value="<p>I/We authorize UBS Europe SE (&quot;UBS&quot;) to make all information relating to my/our client relationship with UBS under the banking relationship mentioned above to the aforementioned MFO. This authorization applies to all data and information relating to my/our bank account. UBS is not obligated to make a specified selection of information for the disclosure to the MFO.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_IWeAuthorizeUbsEuropeSeUbsTo_e1757952" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_243048a2f22741c9995c8648cf861469 _value="<p>The information can be transmitted over any communication channel (in addition to postal mail, also by phone, telefax, E-Banking etc.) The MFO is expressly authorized to sign any additional contracts required in this regard. With regard to communication with UBS, the MFO is authorized to hire additional assistance to cover any additional work requirements.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheInformationCanBe_f650dcd7" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <titledraw_56323c12c5db42c98eba597b4b5ae23d _value="<p>2. Restrictions</p>" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_2Restrictions_ee88eba4" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_2faf6375971643998188dc6f25b25dfe _value="<p>The MFO may only issue instructions to UBS in connection with the transmission of information. All other instructions, in particular with regard to financial investments, must be issued by the account holder and/or other authorized persons.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheMfoMayOnlyIssue_7f469c67" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_adf4a807731840f3acad3edccafb18e5 _value="<p>The MFO is not authorized to deduct securities/value rights or funds of any kind either completely or in part or to make pledges or payments of any kind to the detriment of the client&#39;s account.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheMfoIsNotAuthorizedToDeduct_fc997b57" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_07b29483856141079a61fdeb809ddb4b _value="<p>Unless I/we have not issued any delivery instructions to the contrary, the MFO shall not have access to my/our correspondence, neither in the case of agreed direct mail to an address specified by me/us nor in the case of agreed mail custody (&quot;keep-mail&quot;). However, the MFO is authorized to accept duplicates and copies of all correspondence relating to me/us.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_UnlessIWeHaveNotIssuedAny_3255faff" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <titledraw_37ab6178cde7466ea00b910a1a046336 _value="<p>3. Banking secrecy</p>" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_3BankingSecrecy_de86f383" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_3b64d8e6fc9348c5b910e8e81d2846cf _value="<p>I/We am/are aware that German law (e.g., in relation to banking secrecy and data protection) is limited to Germany and that all data being transmitted to another legal jurisdiction is governed by the prevailing laws in that place. I/We waive all rights pertaining to the confidentiality provisions and the relevant legislation to which UBS in Germany is subject, to the extent that they cannot be obeyed under this authorization in disclosing information to the MFO. In particular we acknowledge that UBS cannot be held liable for any consequences resulting from the cross-border transmission of information into jurisdictions where local legislation differs from German banking secrecy and data protection provisions.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_IWeAmAreAwareThatGermanLawEG_b27dfd1f" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <titledraw_193930ce5640499e9d3b956a0e60a68d _value="<p>4. Validity</p>" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_4Validity_0f87cb11" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_1f5d4b3a242d486ab27e2bb29cbc79d5 _value="<p>This authorization remains in effect until expressly revoked by me/us and UBS has been informed of this measure in writing. The authorization remains valid even after my/our death incapacity.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ThisAuthorizationRemainsIn_8ad9b846" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <titledraw_d6a1e7f311a749138ba7f62bf98cb243 _value="<p>5. Applicable law and place of jurisdiction</p>\n" dorFieldStyling="Default" guideNodeClass="guideTextDraw" headingLevel="4" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="TTL_ApplicableLawAndPlaceOf_1c6a8334" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/titledraw" textIsRich="true">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_c37f3878a81548f194d2dd2d58ff7217 _value="<p>This authorization shall be governed by and construed in accordance with German law.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ThisAuthorizationShallBe_afa3cc26" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_a7a4d214179b42ef8bc0a65aedf94598 _value="<p>The place of performance of all obligations shall be Frankfurt am Main. All disputes shall, within the limits of applicable law, be of the exclusive competent of the courts of Frankfurt am Main.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ThePlaceOfPerformanceOfAll_e4a4250d" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_2e324529849947e49b408e1c3325397b _value="<p>However, UBS reserves the right to assert its rights also before the courts of the domicile of the issuer of the authorization or before any other competent court, subject exclusively to German law.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_HoweverUbsReservesTheRightTo_07f20a6a" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
