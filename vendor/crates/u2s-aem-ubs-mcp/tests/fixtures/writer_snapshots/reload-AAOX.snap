                <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                  <textdraw_450f2d02bd8e453bbd487341c89e7be2 _value="<p>Con riferimento ai Servizi di Pagamento richiesti con la sottoscrizione del relativo contratto, il Cliente consapevole che il mancato consenso non consentirebbe alla Banca l&#39;esecuzione dei predetti servizi di pagamento, presta il proprio consenso – ai sensi dell&#39;art. 29, comma 1-BIS del D.Lgs. 11/2010 – all&#39;accesso, trattamento e conservazione dei dati personali da parte della Banca in relazione all&#39;erogazione dei predetti servizi.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_ConRiferimentoAiServiziDi_84464274" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
                  <textdraw_fd938265e67544b3b4b5f604a6688447 _value="<p>Il trattamento dei dati personali del Cliente sarà effettuato nel rispetto dell&#39;Informativa Privacy consegnata al Cliente e, comunque, sempre disponibile sul sito della Banca.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_IlTrattamentoDeiDatiPersonali_4d8d6b81" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
                    <fd:rules jcr:primaryType="nt:unstructured">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                      <default jcr:primaryType="nt:unstructured" offset="0" width="12">
