                  <textdraw_5879bb925fc247afab4e3aed9b528582 _value="<p>The questionnaire below has been created by UBS Europe SE to comply with self-imposed due diligence obligations as well as legal and regulatory obligations in Germany.</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_TheQuestionnaireBelowHasBeen_fa3e17e5" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
