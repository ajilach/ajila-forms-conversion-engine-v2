                  <textdraw_62582557f9e044719dba647013977319 _value="<p>UBS AG is a member of the Wolfsberg Group, an association of global banks that have committed themselves to adhere to due diligence obligations in combating money laundering. This includes gathering information from clients, that facilitates the creation of detailed documentation on the source of wealth (description of the circumstance/activity which has led to the accumulation of wealth).</p>" css="" dorFieldStyling="Default" guideNodeClass="guideTextDraw" jcr:created="{Date}<DATE>" jcr:createdBy="blueprint" jcr:lastModified="{Date}<DATE>" jcr:lastModifiedBy="blueprint" jcr:primaryType="nt:unstructured" name="ST_UbsAgIsAMemberOfTheWolfsberg_dc426b73" sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/textdraw" textIsRich="true">
