              <xs:element name="Year3" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate3" type="xs:string" minOccurs="0"/>
              <xs:element name="MonthYear4" type="xs:date" minOccurs="0"/>
              <xs:element name="Month4" type="xs:string" minOccurs="0"/>
              <xs:element name="Year4" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupDate4" type="xs:string" minOccurs="0"/>
              <xs:element name="BlockOrder" type="xs:string" minOccurs="0"/>
              <xs:element name="From" type="xs:string" minOccurs="0"/>
              <xs:element name="RbGroupTo" type="xs:string" minOccurs="0"/>
