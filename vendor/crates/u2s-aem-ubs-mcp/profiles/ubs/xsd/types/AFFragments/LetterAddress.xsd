<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" elementFormDefault="qualified" attributeFormDefault="unqualified" vc:minVersion="1.1">
	<xs:include schemaLocation="../AFFragments/Address.xsd"/>
	<xs:element name="Classification" type="xs:string"/>
	<xs:element name="Greeting" type="xs:string"/>
	<xs:element name="Subject" type="xs:string"/>
	<xs:element name="LetterDate" type="xs:date"/>
	<xs:element name="OurReference" type="xs:string"/>
	<xs:element name="YourReference" type="xs:string"/>
	<xs:element name="ReceiverAddress" type="ReceiverAddressType"/>
	<xs:element name="SenderAddress" type="SenderAddressType"/>
	<xs:element name="Letter" type="LetterType"/>
	<xs:complexType name="LetterAddressType">
		<xs:annotation>
			<xs:documentation>base letter address type</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LetterPartnerClass" type="xs:string" minOccurs="0"/>
			<xs:element name="Title" type="xs:string" minOccurs="0"/>
			<xs:element name="LastName" type="xs:string" minOccurs="0"/>
			<xs:element name="FirstName" type="xs:string" minOccurs="0"/>
			<xs:element name="LegalEntityName" type="xs:string" minOccurs="0"/>
			<xs:element name="LetterAddress" type="AddressType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ReceiverAddressType">
		<xs:complexContent>
			<xs:extension base="LetterAddressType"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SenderAddressType">
		<xs:complexContent>
			<xs:extension base="LetterAddressType">
				<xs:sequence>
					<xs:element name="AdditionalReferences" type="xs:string" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="LetterType">
		<xs:sequence>
			<xs:element ref="SenderAddress" minOccurs="0"/>
			<xs:element ref="ReceiverAddress"/>
			<xs:element ref="LetterDate"/>
			<xs:element ref="YourReference" minOccurs="0"/>
			<xs:element ref="OurReference" minOccurs="0"/>
			<xs:element ref="Classification" minOccurs="0"/>
			<xs:element ref="Subject"/>
			<xs:element ref="Greeting"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>