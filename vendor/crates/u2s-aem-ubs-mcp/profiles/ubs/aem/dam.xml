<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:fd="http://www.adobe.com/aemfd/fd/1.0"
    xmlns:dam="http://www.day.com/dam/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:mix="http://www.jcp.org/jcr/mix/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="dam:Asset">
    <jcr:content
        jcr:primaryType="dam:AssetContent"
        sling:resourceType="fd/fm/af/render"
        guide="1"
        type="guide">
        <dictionary jcr:primaryType="nt:unstructured">
            {% set langs = expanded_languages | split(pat=",") %}{% for lang in langs %}<{{ lang }} jcr:primaryType="nt:unstructured"/>
            {% endfor %}
        </dictionary>
        <metadata
            fd:version="1.1"
            jcr:mixinTypes="[mix:created,mix:lastModified]"
            jcr:primaryType="nt:unstructured"
            allowedRenderFormat="HTML"
            author="{{ author }}"
            availableInMobileApp="{Boolean}false"
            {% if variables.dor_template_ref is defined and variables.dor_template_ref != "" %}dorTemplateRef="{{ variables.dor_template_ref }}"{% endif %}
            dorType="{{ variables.dor_type | default(value='generate') }}"
            formmodel="{% if xsd_ref %}xsd{% else %}none{% endif %}"
            {% if xsd_ref %}xsdRef="{{ xsd_ref }}"{% endif %}
            hasCustomThumbnail="{Boolean}false"
            {% if variables.use_summary == "true" %}redactoSummary="true"{% endif %}
            {% if variables.theme_ref is defined and variables.theme_ref != "" %}themeRef="{{ variables.theme_ref }}"{% endif %}
            availableStylings="[ajila-forms-ubs-ebanking-styling]"
            menuOptions="[ajila-forms-ubs-menu-option-save]"
            title="{{ form_code }}"/>
    </jcr:content>
</jcr:root>
