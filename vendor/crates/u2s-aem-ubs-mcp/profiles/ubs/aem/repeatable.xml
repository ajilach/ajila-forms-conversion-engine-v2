<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    {% if css %}css="{{ css }}"{% endif %}
    dorExcludeDescription="true"
    dorExcludeTitle="true"
    {% if dor_exclude %}dorExclusion="true"{% endif %}
    guideNodeClass="guidePanel"
    name="{{ name }}"
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude %}summaryExclusion="true"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"
    {% if not visible %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
        {# The repeating panel proper. Its properties are what the UBS client
           library reads: `dorFieldStyling="Repeating Panel Numbering"` is what
           makes it number the rows, and `headingLevel` is what makes AEM render
           `jcr:title` server-side -- without it the first row shows no heading
           until it has been re-rendered. `dorExcludeTitle` is deliberately
           absent (absent is how AEM spells the default): the title is the row
           heading the numbering is built on. See the repeating-panel archetype
           in the feedback repo (PROBLEM-repeating-panel). #}
        <repeatableInner
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            jcr:title="{{ subject }}"
            sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
            accessibilityLabel="{{ subject }}"
            {% if not is_signature_twin %}addButton="BT_Add"
            {% endif %}ajilaPanelSubject="{{ subject }}"
            {% if bind_ref %}bindRef="{{ bind_ref }}"
            {% endif %}dorExcludeDescription="true"
            dorFieldStyling="Repeating Panel Numbering"
            guideNodeClass="guidePanel"
            headingLevel="3"
            {# One button per row, which is what a person coming back from the
               summary wants; the step-title panel gives its own up in
               `panel.xml` (PROBLEM-jump-to-field-button, owner directive
               2026-08-24). Left off on a step with nothing to fill in and on the
               form configurator. #}
            {% if jump_to_field_button %}jumpToFieldButtonVisible="true"
            {% endif %}maxOccur="{{ max_occur }}"
            minOccur="{{ min_occur }}"
            name="{{ panel_name }}"
            {% if not is_signature_twin %}removeButton="BT_Remove"
            {% endif %}summaryHeadingLevel="4"
            textIsRich="true"
            validateOnStepCompletion="{Boolean}false">
            <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
            <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                {#  A signature twin is driven by its data panel's buttons and
                    has none of its own: a Remove here would let the two panels
                    desync (PROBLEM-repeating-panel §8). The `addButton` /
                    `removeButton` properties are left off above for the same
                    reason, and that is what tells the engine validator this
                    panel is driven rather than defective. #}
                {% if not is_signature_twin %}
                <removebutton
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/removebutton"
                    dorExclusion="true"
                    summaryExclusion="true"
                    dorFieldStyling="{{ variables.dor_field_styling }}"
                    guideNodeClass="guideButton"
                    name="BT_Remove"
                    textIsRich="[true,true]"
                    type="Button"
                    visible="{Boolean}false">
                    <fd:rules jcr:primaryType="nt:unstructured"/>
                    <fd:scripts fd:click="[{&quot;script&quot;:{&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nvar repeatingPanel = this.parent;\\nvar addButton = this.parent.parent.BT_Add;\\nwindow.forms.ubs.removeInstance(repeatingPanel);{% if signature_twin %}\\nwindow.forms.ubs.removeInstance({{ signature_twin }});{% endif %}\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabels(repeatingPanel\, \\&quot;{{ rule_label }}\\&quot;\, addButton);\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabelsForButtons(repeatingPanel\, \\&quot;{{ rule_label }}\\&quot;\, addButton\, this);{% if signature_twin %}\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabelsForButtons({{ signature_twin }}\, \\&quot;{{ rule_label }}\\&quot;\, \\&quot;\\&quot;\, \\&quot;\\&quot;);{% endif %}&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;field&quot;:&quot;BT_Remove&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" fd:visible="[{&quot;script&quot;:{&quot;field&quot;:&quot;BT_Remove&quot;\,&quot;event&quot;:&quot;Visibility&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nthis.parent.instanceIndex === this.parent.instanceManager.instances.length - 1 &amp;&amp; this.parent.instanceManager.instances.length &gt; this.parent.instanceManager.minOccur;&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" fd:init="[{&quot;script&quot;:{&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nthis.visible = (this.parent.instanceIndex === this.parent.instanceManager.instances.length - 1 &amp;&amp; this.parent.instanceManager.instances.length &gt; this.parent.instanceManager.minOccur);&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;field&quot;:&quot;BT_Remove&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" jcr:primaryType="nt:unstructured"/>
                </removebutton>
                {% endif %}
                <panel_copy_copy
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
                    dorExcludeDescription="true"
                    dorExcludeTitle="true"
                    guideNodeClass="guidePanel"
                    name="{{ row_name }}"
                    textIsRich="true"
                    validateOnStepCompletion="{Boolean}false">
                    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
                    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                        {{ children }}
                    </items>
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default jcr:primaryType="nt:unstructured" offset="0" width="12"/>
                    </cq:responsive>
                </panel_copy_copy>
            </items>
        </repeatableInner>
        {% if not is_signature_twin %}
        <tertiarybutton
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            jcr:title="{% if add_label %}{{ add_label }}{% else %}Add{% endif %}"
            sling:resourceType="{{ variables.custom_resource_type_base }}/controls/tertiarybutton"
            dorExclusion="true"
            summaryExclusion="true"
            dorFieldStyling="{{ variables.dor_field_styling }}"
            guideNodeClass="guideButton"
            name="BT_Add"
            textIsRich="[true,true]"
            type="Button">
            <fd:rules jcr:primaryType="nt:unstructured"/>
            <fd:scripts fd:click="[{&quot;script&quot;:{&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nwindow.forms.ubs.addInstance(this.parent.{{ panel_name }});{% if signature_twin %}\\nwindow.forms.ubs.addInstance({{ signature_twin }});{% endif %}\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabels(this.parent.{{ panel_name }}\, \\&quot;{{ rule_label }}\\&quot;\, this);\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabelsForButtons(this.parent.{{ panel_name }}\, \\&quot;{{ rule_label }}\\&quot;\, this\, this.parent.{{ panel_name }}.instanceManager.instances[this.parent.{{ panel_name }}.instanceManager.instances.length - 1].BT_Remove);{% if signature_twin %}\\nwindow.forms.ubs.accessibility.setRepeatPanelAccessibilityLabelsForButtons({{ signature_twin }}\, \\&quot;{{ rule_label }}\\&quot;\, \\&quot;\\&quot;\, \\&quot;\\&quot;);{% endif %}&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;field&quot;:&quot;BT_Add&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" fd:visible="[{&quot;script&quot;:{&quot;field&quot;:&quot;BT_Add&quot;\,&quot;event&quot;:&quot;Visibility&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nthis.parent.{{ panel_name }}.instanceManager.instances.length &lt; this.parent.{{ panel_name }}.instanceManager.maxOccur;&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" fd:init="[{&quot;script&quot;:{&quot;content&quot;:&quot;// [repeating-panel] Generated automatically. Do not edit: will be overwritten. Create your own different script.\\nthis.visible = (this.parent.{{ panel_name }}.instanceManager.instances.length &lt; this.parent.{{ panel_name }}.instanceManager.maxOccur);&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;field&quot;:&quot;BT_Add&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true\,&quot;_archetype&quot;:&quot;repeating-panel&quot;}]" jcr:primaryType="nt:unstructured"/>
        </tertiarybutton>
        {% endif %}
    </items>
    {{ raw_children }}
</{{ element_name }}>
