<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    {% if not is_page and title and title != "" %}jcr:title="{{ title }}"{% endif %}
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    {% if css %}css="{{ css }}"{% elif name is starting_with("PN_FormConfigurator") %}css="ubs-margin-10"{% endif %}
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    dorExcludeDescription="true"
    {% if dor_exclude_title or is_page %}dorExcludeTitle="true"{% endif %}
    {% if dor_exclude or name == "PN_BR" %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    {% if dor_header_slot %}dorHeaderSlot="{{ dor_header_slot }}"{% endif %}
    guideNodeClass="guidePanel"
    {% if jump_to_field %}jumpToFieldButtonVisible="true"{% endif %}
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude or name is starting_with("PN_FormConfigurator") or name == "PN_BR" %}summaryExclusion="true"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"
    {% if not visible %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
        {% if is_page and title and title != "" %}
        {#  Only a real first-page heading becomes the subtitle. The form
            configurator's heading belongs to the configurator and stays an
            `h2` step title inside it (PROBLEM-banking-subtitle, owner
            directive 2026-09-01) -- and in this profile the configurator IS
            the first page, so without the exclusion every configurator step
            would be converted. #}
        {% set is_subtitle_page = is_first_page and not is_form_configurator %}
        <panel_title_{{ uuid }}
            jcr:created="{Date}2025-01-01T00:00:00.000Z"
            jcr:createdBy="{{ author }}"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            {#  On the first page the heading below is a static text; this panel
                repeating it as its own title would render the subtitle twice
                (PROBLEM-banking-subtitle, owner directive 2026-08-26). The panel
                itself stays: it is what carries the jump-to-field button. #}
            {% if not is_subtitle_page %}jcr:title="{{ title }}"{% endif %}
            sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
            dorExcludeDescription="true"
            {% if is_form_configurator %}dorExclusion="true" summaryExclusion="true"{% endif %}
            dorFieldStyling="{{ variables.dor_field_styling }}"
            guideNodeClass="guidePanel"
            name="{{ name }}Title"
            textIsRich="true"
            {# The button jumps back to a field, so a step with nothing to fill
               in — legal provisions, a declaration, terms — gets none. The form
               configurator gets none either: it would then also appear in the
               summary jump-list. And on a step that holds a repeatable the
               button belongs to the rows, one per instance, so this panel gives
               it up rather than rendering a second one above the heading
               (PROBLEM-jump-to-field-button, owner directive 2026-08-24). #}
            {% if is_page and has_input and not is_form_configurator and not has_repeatable %}jumpToFieldButtonVisible="true"{% endif %}
            validateOnStepCompletion="{Boolean}false">
            <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
            <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                {#  First page: a plain static text carrying `subtitle-after-form-title`,
                    which is what renders in the finished DoR -- an `h2` step title does
                    not. It carries no DoR or summary exclusion for the same reason: the
                    heading is meant to appear there. Every other page keeps its step
                    title (PROBLEM-banking-subtitle). #}
                {% if is_subtitle_page %}
                <textdraw_{{ uuid }}
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/textdraw"
                    _value="&lt;p>{{ title }}&lt;/p>&#xa;"
                    css="subtitle-after-form-title"
                    dorFieldStyling="{{ variables.dor_field_styling }}"
                    guideNodeClass="guideTextDraw"
                    name="ST_{{ name | replace(from="PN_", to="") }}"
                    textIsRich="true"/>
                {% else %}
                <titledraw_{{ uuid }}
                    jcr:created="{Date}2025-01-01T00:00:00.000Z"
                    jcr:createdBy="{{ author }}"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/titledraw"
                    _value="&lt;p>{{ title }}&lt;/p>&#xa;"
                    css="stepTitle"
                    dorExclusion="true"
                    dorFieldStyling="{{ variables.dor_field_styling }}"
                    guideNodeClass="guideTextDraw"
                    headingLevel="2"
                    name="TTL_{{ name | replace(from="PN_", to="") }}"
                    summaryExclusion="true"
                    textIsRich="true"/>
                {% endif %}
            </items>
        </panel_title_{{ uuid }}>
        {% endif %}
        {{ children }}
    </items>
    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar"{% if dor_num_cols %} dorNumCols="{{ dor_num_cols }}"{% endif %} nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
    {{ raw_children }}
</{{ element_name }}>
