<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/textdraw"
    _value="{{ content }}"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    css="{% if css %}{{ css }}{% endif %}"
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    {% if dor_exclude %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    {% if dor_header_slot %}dorHeaderSlot="{{ dor_header_slot }}"{% endif %}
    guideNodeClass="guideTextDraw"
    name="{{ name }}"
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude %}summaryExclusion="true"{% endif %}
    textIsRich="true"
    {% if not visible %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    {% if not has_passthrough_rules %}<fd:rules jcr:primaryType="nt:unstructured"/>{% endif %}
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
    {{ raw_children }}
</{{ element_name }}>
