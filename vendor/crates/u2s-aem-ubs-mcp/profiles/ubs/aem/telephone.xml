<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    {% if label and label != "" %}jcr:title="{{ label }}"{% endif %}
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/telephone"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    assistPriority="label"
    autofillFieldKeyword="tel"
    css="{% if css %}{{ css }}{% else %}{{ variables.css_telephone }}{% endif %}"
    displayIsSameAsValidate="true"
    displayPatternType="custom"
    displayPictureClause="{{ variables.tel_validate_clause }}"
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    {% if dor_exclude_title %}dorExcludeTitle="true"{% endif %}
    {% if dor_exclude %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    {% if dor_header_slot %}dorHeaderSlot="{{ dor_header_slot }}"{% endif %}
    guideNodeClass="guideTelephone"
    mandatory="{{ mandatory }}"
    {% if max_chars %}maxChars="{{ max_chars }}"{% endif %}
    name="{{ name }}"
    {% if bind_ref %}bindRef="{{ bind_ref }}"{% endif %}
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude %}summaryExclusion="true"{% endif %}
    textIsRich="[true,true,true]"
    validatePictureClause="{{ variables.tel_validate_clause }}"
    validatePictureClauseMessage="{{ variables.tel_validate_message }}"
    validationPatternType="custom"
    {% if not visible %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
    {{ raw_children }}
</{{ element_name }}>
