<{{ element_name }}
    jcr:created="{Date}2025-01-01T00:00:00.000Z"
    jcr:createdBy="{{ author }}"
    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
    jcr:lastModifiedBy="{{ author }}"
    jcr:primaryType="nt:unstructured"
    {% if title and title != "" %}jcr:title="{{ title }}"{% endif %}
    sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
    {% if always_in_pdf %}alwaysInPdf="true"{% endif %}
    {% if css %}css="{{ css }}"{% endif %}
    {% if dor_colspan %}dorColspan="{{ dor_colspan }}"{% endif %}
    dorExcludeDescription="true"
    dorExcludeTitle="true"
    {% if dor_exclude %}dorExclusion="true"{% endif %}
    dorFieldStyling="{{ variables.dor_field_styling }}"
    guideNodeClass="guidePanel"
    {% if variables.use_summary == "true" %}hideTitle="{Boolean}true"{% endif %}
    name="{{ name }}"
    {% if show_if_hidden %}showIfHidden="true"{% endif %}
    {% if dor_exclude or summary_exclude %}summaryExclusion="true"{% endif %}
    textIsRich="true"
    validateOnStepCompletion="{Boolean}false"
    {% if not visible and not visibility_triggers %}visible="{Boolean}false"{% endif %}{{ extra_attributes }}>
    <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
        {{ children }}
    </items>
    <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar"{% if dor_num_cols %} dorNumCols="{{ dor_num_cols }}"{% endif %} nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
    {% if visibility_triggers %}
    <fd:rules jcr:primaryType="nt:unstructured"/>
    <!-- The Visibility rule only fires when a trigger's value *changes*, so on a
         freshly opened form (or one reloaded from a draft) it never runs and the
         panel keeps whatever state the node was left in. The same condition is
         therefore repeated on Initialize, with the result written as an
         assignment because an Initialize rule's evaluated result is discarded. -->
    <fd:scripts fd:visible="[{&quot;script&quot;:{&quot;field&quot;:&quot;{{ name }}&quot;\,&quot;event&quot;:&quot;Visibility&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;SHOW_EXPRESSION&quot;}\,&quot;content&quot;:&quot;if ({% for t in visibility_triggers %}{{ t.field }}.value == \\&quot;{{ t.value | escape }}\\&quot;{% if not loop.last %} || {% endif %}{% endfor %}) {\\n  window.forms.ubs.showAFShowDor(this);\\n  true;\\n} else {\\n  window.forms.ubs.hideAFHideDor(this);\\n  false;\\n}\\n&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]" fd:init="[{&quot;script&quot;:{&quot;field&quot;:&quot;{{ name }}&quot;\,&quot;event&quot;:&quot;Initialize&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;if ({% for t in visibility_triggers %}{{ t.field }}.value == \\&quot;{{ t.value | escape }}\\&quot;{% if not loop.last %} || {% endif %}{% endfor %}) {\\n  window.forms.ubs.showAFShowDor(this);\\n  this.visible = true;\\n} else {\\n  window.forms.ubs.hideAFHideDor(this);\\n  this.visible = false;\\n}\\n&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]" jcr:primaryType="nt:unstructured"/>
    {% endif %}
    <cq:responsive jcr:primaryType="nt:unstructured">
        <default jcr:primaryType="nt:unstructured" offset="0" width="{{ colspan }}"/>
    </cq:responsive>
    {{ raw_children }}
</{{ element_name }}>
