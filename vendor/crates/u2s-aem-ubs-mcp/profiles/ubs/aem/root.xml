<?xml version="1.0" encoding="UTF-8"?>
<jcr:root
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    xmlns:fd="http://www.adobe.com/aemfd/fd/1.0"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[/etc/mobile/groups/responsive]"
        cq:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
        cq:lastModifiedBy="{{ author }}"
        cq:template="{{ variables.template_path }}"
        jcr:language="{{ master_language }}"
        jcr:primaryType="cq:PageContent"
        jcr:title="{{ form_code }}"
        sling:resourceType="{{ variables.page_resource_type }}">
        <parsys1 jcr:primaryType="nt:unstructured" sling:resourceType="wcm/foundation/components/responsivegrid">
            <guideheader jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.custom_resource_type_base }}/controls/guideheader"/>
            <guideformtitle jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.custom_resource_type_base }}/controls/formtitle" _value="&lt;p&gt;{{ title }}&lt;/p&gt;" css="guideformtitle container" guideNodeClass="guideTextDraw" name="formTitle" textIsRich="true"/>
        </parsys1>
        <guideContainer
            fd:version="1.1"
            jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
            jcr:lastModifiedBy="{{ author }}"
            jcr:primaryType="nt:unstructured"
            sling:resourceType="{{ variables.resource_type_base }}/guideContainer"
            actionType="{{ variables.action_type }}"
            autoSaveStrategyType="fd/fp/components/actions/autosave/timebased"
            clientLibRef="{{ variables.client_lib_ref }}"
            disableSwipeGesture="{Boolean}false"
            {% if variables.dor_template_ref is defined and variables.dor_template_ref != "" %}dorTemplateRef="{{ variables.dor_template_ref }}"{% endif %}
            dorType="{{ variables.dor_type }}"
            enableFocusOnFirstField="{Boolean}true"
            enableLayoutLayer="false"
            guideCss="guideContainer"
            guideNodeClass="guideContainerNode"
            name="guide1"
            {% if variables.redirect_url is defined and variables.redirect_url != "" %}redirect="{{ variables.redirect_url }}"{% endif %}
            textIsRich="true"
            thankYouMessage="Thank you for submitting the form."
            thankYouOption="page"
            {% if variables.theme_ref is defined and variables.theme_ref != "" %}themeRef="{{ variables.theme_ref }}"{% endif %}
            useExistingAF="false"
            {% if xsd_path is defined %}
            schemaType="xmlschema"
            xsdRef="{{ xsd_path }}"
            xsdRootElement="form"
            {% endif %}
            >
            <layout jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/defaultGuideLayout" mobileLayout="fd/af/layouts/mobile/step" toolbarPosition="Bottom"/>
            <rootPanel
                jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
                jcr:lastModifiedBy="{{ author }}"
                jcr:primaryType="nt:unstructured"
                jcr:title="Root Panel"
                sling:resourceType="fd/af/components/rootPanel"
                completionExpReq="{Boolean}true"
                dorExcludeDescription="true"
                dorExcludeTitle="true"
                guideNodeClass="rootPanelNode"
                name="guideRootPanel"
                panelSetType="Navigable"
                validateOnStepCompletion="{Boolean}true">
                <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.wizard_layout }}" enableLayoutOptimization="true" guideNavigatorTab="wizard-tab" toolbarPosition="Bottom"/>
                <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                    <fragment_formmetadata
                        jcr:primaryType="nt:unstructured"
                        jcr:title="FormMetadata"
                        sling:resourceType="{{ variables.custom_resource_type_base }}/controls/panel"
                        dorExcludeDescription="true"
                        dorExcludeTitle="true"
                        dorExclusion="true"
                        summaryExclusion="true"
                        fragRef="/content/dam/formsanddocuments/afforms_global_fragmentlib/formmetadata"
                        guideNodeClass="guidePanel"
                        name="FormMetadata"
                        textIsRich="true"
                        visible="false">
                        <layout
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="{{ variables.default_layout }}"
                            columns="1"
                            dorLayoutType="columnar"
                            dorNumCols="1"
                            nonNavigable="{Boolean}true"
                            toolbarPosition="Bottom"/>
                        <items
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="{{ variables.default_layout }}"/>
                    </fragment_formmetadata>
                    {{ children }}
                    {% if variables.use_summary == "true" %}
                    <summarypanel
                        jcr:created="{Date}2025-01-01T00:00:00.000Z"
                        jcr:createdBy="{{ author }}"
                        jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                        jcr:lastModifiedBy="{{ author }}"
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Summary of form information"
                        sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel"
                        dorExclusion="true"
                        dorFieldStyling="Default"
                        summaryExclusion="true"
                        guideNodeClass="guidePanel"
                        name="summaryPanel"
                        textIsRich="true"
                        validateOnStepCompletion="{Boolean}false"
                        visible="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2">
                            <messagebox_ElsigCheck
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox"
                                css="messagebox-ElsigCheck ubs-margin-10"
                                guideNodeClass="guideTextDraw"
                                hideTitle="{Boolean}true"
                                i18nBodyId="ajila-forms-ubs-signature-level-error"
                                name="messagebox_ElsigCheck"
                                visible="{Boolean}true"/>
                            <summary
                                jcr:created="{Date}2025-01-01T00:00:00.000Z"
                                jcr:createdBy="{{ author }}"
                                jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                                jcr:lastModifiedBy="{{ author }}"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Summary"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/summary"
                                autofillFieldKeyword="name"
                                css="widget_ajila_forms_summary"
                                dorFieldStyling="Default"
                                guideNodeClass="guideTextBox"
                                name="summaryComponent"
                                replaceEmptyValues="true"
                                showStaticText="true"
                                textIsRich="[true,true,true]"/>
                            <messagebox_SubmissionError
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox"
                                guideNodeClass="guideTextDraw"
                                messageboxBody="&lt;p&gt;The form could not be sent. Please try again later.&lt;/p&gt;"
                                messageboxTitle="Submission failed"
                                messageboxType="{Long}4"
                                name="submitErrorMessage"
                                visible="{Boolean}false"/>
                            <doroptionsubs
                                jcr:created="{Date}2025-01-01T00:00:00.000Z"
                                jcr:createdBy="{{ author }}"
                                jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                                jcr:lastModifiedBy="{{ author }}"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/dorOptionsUBS"
                                _value="Further configurations for the document of record"
                                dorExclusion="true"
                                summaryExclusion="true"
                                guideNodeClass="guideTextDraw"
                                name="doroptionsubs"
                                visible="false"/>
                            <metadata
                                jcr:created="{Date}2025-01-01T00:00:00.000Z"
                                jcr:createdBy="{{ author }}"
                                jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                                jcr:lastModifiedBy="{{ author }}"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/metadata"
                                _value="Metadata"
                                dorExclusion="true"
                                summaryExclusion="true"
                                {#  The issuing region's language (profile variable), except that a
                                    form shipping one language alone masters that one, and a region
                                    language the form does not ship falls back to EN. #}
                                {%- set langs = languages | upper | split(pat=",") -%}
                                formrange_afmasterlanguage="{% if langs | length == 1 %}{{ languages | upper }}{% elif langs is containing(variables.metadata_master_language) %}{{ variables.metadata_master_language }}{% else %}EN{% endif %}"
                                formrange_aftype="Single"
                                formrange_code="{{ variables.form_code }}"
                                guideNodeClass="guideTextDraw"
                                name="metadataTextDraw"
                                visible="false">
                                <entities jcr:primaryType="nt:unstructured">
                                    <item0
                                        jcr:primaryType="nt:unstructured"
                                        formrange_clpmandatory="{% if xfa.formrange_clpmandatory is defined and xfa.formrange_clpmandatory != '' %}{{ xfa.formrange_clpmandatory }}{% else %}false{% endif %}"
                                        formrange_entity="{{ xfa.formrange_entity }}"
                                        formrange_language="{{ languages | upper }}">
                                        <cdoks jcr:primaryType="nt:unstructured">
                                            <item0
                                                jcr:primaryType="nt:unstructured"
                                                formrange_cdokinfo="{% if xfa.formrange_cdokinfo is defined and xfa.formrange_cdokinfo != '' %}{{ xfa.formrange_cdokinfo }}{% elif xfa.Footer_Line_txtformid is defined %}{{ xfa.Footer_Line_txtformid }}{% endif %}"
                                                formrange_partnerlevel="{% if xfa.formrange_partnerlevel is defined and xfa.formrange_partnerlevel != '' %}{{ xfa.formrange_partnerlevel }}{% else %}false{% endif %}"
                                                formrange_releasedate="{% if xfa.formrange_releasedate is defined and xfa.formrange_releasedate != '' %}{{ xfa.formrange_releasedate }}{% elif xfa.Footer_Line_txtversiondate is defined %}{{ xfa.Footer_Line_txtversiondate }}{% endif %}"
                                                formrange_version="{% if xfa.formrange_version is defined %}{{ xfa.formrange_version }}{% endif %}"/>
                                        </cdoks>
                                    </item0>
                                </entities>
                            </metadata>
                        </items>
                        <layout jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
                    </summarypanel>
                    {% endif %}
                    {#  The carousel preview step is obsolete wherever Redacto
                        renders the DoR: it renders the preview its own way
                        (PROBLEM-preview-step-removed, owner directive
                        2026-09-01). It also duplicated two names the summary
                        panel above carries — `messagebox_ElsigCheck` and
                        `submitErrorMessage`, the one the toolbar's Submit
                        names. A profile that runs without the summary keeps the
                        step, which is the only place a preview then exists. #}
                    {% if variables.use_summary != "true" %}
                    <previewpanel
                        jcr:created="{Date}2025-01-01T00:00:00.000Z"
                        jcr:createdBy="{{ author }}"
                        jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                        jcr:lastModifiedBy="{{ author }}"
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Preview"
                        sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/panel"
                        dorExclusion="true"
                        summaryExclusion="true"
                        guideNodeClass="guidePanel"
                        name="preview"
                        textIsRich="true"
                        validateOnStepCompletion="{Boolean}false">
                        <items jcr:primaryType="nt:unstructured" sling:resourceType="{{ variables.default_layout }}">
                            <messagebox_ElsigCheck
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox"
                                css="messagebox-ElsigCheck ubs-margin-10"
                                guideNodeClass="guideTextDraw"
                                hideTitle="{Boolean}true"
                                i18nBodyId="ajila-forms-ubs-signature-level-error"
                                name="messagebox_ElsigCheck"
                                visible="{Boolean}true"/>
                            <messagebox_SubmissionInfo
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox"
                                guideNodeClass="guideTextDraw"
                                hideTitle="{Boolean}true"
                                messageboxBody="&lt;p&gt;By clicking on &quot;Preview&quot;, you can review your document before submission.&lt;/p&gt;&lt;p&gt;After clicking &quot;Submit&quot;, you will no longer be able to edit the document and the PDF will be created for signing.&lt;/p&gt;"
                                name="previewInformation"
                                visible="{Boolean}true"/>
                            <carousel
                                jcr:created="{Date}2025-01-01T00:00:00.000Z"
                                jcr:createdBy="{{ author }}"
                                jcr:lastModified="{Date}2025-01-01T00:00:00.000Z"
                                jcr:lastModifiedBy="{{ author }}"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Preview Carousel"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/carousel"
                                arrows="true"
                                autofillFieldKeyword="name"
                                css="widget_ajila_forms_carousel"
                                displayPatternType="custom"
                                displayPictureClause="\[0-9]"
                                dorExclusion="true"
                                summaryExclusion="true"
                                guideNodeClass="guideTextBox"
                                initScript="com.ajila.forms.control.carousel.initialize(this)"
                                lazyLoadingStrategy="ondemand"
                                name="carouselPreview"
                                placeholderText="Message"
                                showDots="true"
                                slidesToScroll="1"
                                slidesToShow="1"
                                textIsRich="[true,true,true]"
                                visible="{Boolean}false"/>
                            <messagebox_CarouselPreview
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox-CarouselPreviewError"
                                buttonAction="window.com.ajila.forms.control.messagebox_carouselpreview_error.initCarouselPreview()"
                                css="ubs-margin-10"
                                guideNodeClass="guideTextDraw"
                                i18nBodyId="ajila-forms-ubs-errorbox-carousel-message"
                                i18nButtonLabelId="ajila-forms-ubs-errorbox-carousel-button-label"
                                i18nTitleId="ajila-forms-ubs-errorbox-carousel-title"
                                messageboxType="{Long}4"
                                name="previewErrorMessage"
                                showButton="{Boolean}true"
                                visible="{Boolean}false"/>
                            <messagebox_SubmissionError
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/messagebox"
                                guideNodeClass="guideTextDraw"
                                messageboxBody="&lt;p&gt;The form could not be sent. Please try again later.&lt;/p&gt;"
                                messageboxTitle="Submission failed"
                                messageboxType="{Long}4"
                                name="submitErrorMessage"
                                visible="{Boolean}false"/>
                        </items>
                        <layout jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/gridFluidLayout2" columns="1" dorLayoutType="columnar" dorNumCols="1" nonNavigable="{Boolean}true" toolbarPosition="Bottom"/>
                    </previewpanel>
                    {% endif %}
                </items>
                <toolbar
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Toolbar"
                    sling:resourceType="fd/af/components/toolbar"
                    css=""
                    guideNodeClass="guideToolbar"
                    name="toolbar">
                    <items jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/toolbar/defaultToolbarLayout">
                        <nextitemnav
                            fd:targetVersion="1.1"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Next"
                            sling:resourceType="fd/af/components/actions/nextitemnav"
                            dorExclusion="true"
                            summaryExclusion="true"
                            guideNodeClass="guideButton"
                            name="nextitemnav"
                            type="moveNext">
                            <fd:rules jcr:primaryType="nt:unstructured"/>
                            <fd:scripts
                                {% if variables.use_summary == "true" %}fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.nextitemnav&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.ajila.forms.ubs.control.summary.setSummaryData(guideRootPanel);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true},{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.nextitemnav&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.com.ajila.forms.ubs.navigation.nextStep(this);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"{% else %}fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.nextitemnav&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.com.ajila.forms.ubs.navigation.nextStep(this);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"{% endif %}
                                jcr:primaryType="nt:unstructured"/>
                        </nextitemnav>
                        <submit
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Submit"
                            sling:resourceType="fd/af/components/actions/submit"
                            dorExclusion="true"
                            summaryExclusion="true"
                            guideNodeClass="guideButton"
                            name="submit"
                            type="submit">
                            <fd:rules jcr:primaryType="nt:unstructured"/>
                            <fd:scripts
                                fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.submit&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.forms.ubs.navigation.submit(submitErrorMessage);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                fd:navigationChange="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.submit&quot;\,&quot;event&quot;:&quot;Navigation&quot;\,&quot;content&quot;:&quot;this.visible=(!this.panel.navigationContext.hasNextItem);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                jcr:primaryType="nt:unstructured"/>
                        </submit>
                        <previtemnav
                            fd:targetVersion="1.1"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Back"
                            sling:resourceType="fd/af/components/actions/previtemnav"
                            dorExclusion="true"
                            summaryExclusion="true"
                            guideNodeClass="guideButton"
                            name="previtemnav"
                            type="movePrev">
                            <fd:rules jcr:primaryType="nt:unstructured"/>
                            <fd:scripts
                                fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.previtemnav&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.forms.ubs.navigation.previousStep(this);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                jcr:primaryType="nt:unstructured"/>
                        </previtemnav>
                        {#  The Preview button goes with the step it opens: its
                            click names `carouselPreview` and
                            `previewErrorMessage`, both of which live in that
                            step, and a statement naming a node that is not
                            there throws — which in this runtime costs every
                            statement after it in the same rule. #}
                        {% if variables.use_summary != "true" %}
                        <preview
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Preview"
                            sling:resourceType="ajila-forms-customers/ajila-forms-ubs/components/controls/tertiarybutton"
                            css="previewGenerationButton"
                            dorExclusion="true"
                            summaryExclusion="true"
                            guideNodeClass="guideButton"
                            name="preview"
                            textIsRich="[true,true]"
                            type="Button">
                            <fd:rules jcr:primaryType="nt:unstructured"/>
                            <fd:scripts
                                fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.preview&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;com.ajila.forms.control.carousel.initializeForPreview(carouselPreview\, undefined\, previewErrorMessage);&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true},{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.preview&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;carouselPreview.visible = true;\\n\\n&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                fd:navigationChange="[{&quot;script&quot;:{&quot;content&quot;:&quot;this.visible=(!this.panel.navigationContext.hasNextItem);&quot;\,&quot;event&quot;:&quot;Navigation&quot;\,&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.preview&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                jcr:primaryType="nt:unstructured"/>
                        </preview>
                        {% endif %}
                        <guidebutton
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Save Progress"
                            sling:resourceType="fd/af/components/guidebutton"
                            dorExclusion="true"
                            summaryExclusion="true"
                            dorFieldStyling="{{ variables.dor_field_styling }}"
                            guideNodeClass="guideButton"
                            name="fwbSaveProgress"
                            textIsRich="[true,true,true]"
                            type="Button">
                            <fd:rules jcr:primaryType="nt:unstructured"/>
                            <fd:scripts
                                fd:click="[{&quot;script&quot;:{&quot;field&quot;:&quot;guide.guideRootPanel.toolbar.fwbSaveProgress&quot;\,&quot;event&quot;:&quot;Click&quot;\,&quot;model&quot;:{&quot;nodeName&quot;:&quot;EVENT_SCRIPTS&quot;}\,&quot;content&quot;:&quot;window.forms.ubs.fwb.saveFormData();&quot;}\,&quot;nodeName&quot;:&quot;SCRIPTMODEL&quot;\,&quot;version&quot;:1\,&quot;enabled&quot;:true}]"
                                jcr:primaryType="nt:unstructured"/>
                        </guidebutton>
                    </items>
                    <layout jcr:primaryType="nt:unstructured" sling:resourceType="fd/af/layouts/toolbar/defaultToolbarLayout"/>
                </toolbar>
            </rootPanel>
            <autoSaveInfo jcr:primaryType="nt:unstructured" metadataselector="global"/>
            <signerInfo jcr:primaryType="nt:unstructured" firstSignerFormFiller="false" workflowType="SEQUENTIAL">
                <signer0 jcr:primaryType="nt:unstructured" countryCode="undefined" countryCodeSource="undefined" email="undefined" emailSource="undefined" phone="undefined" phoneSource="undefined" securityOption="undefined" signerTitle="Signer One"/>
            </signerInfo>
            <view jcr:primaryType="nt:unstructured">
                <print
                    jcr:created="{Date}2025-01-01T00:00:00.000+01:00"
                    jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00"
                    jcr:lastModifiedBy="{{ author }}"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="fd/af/authoring/components/dor/dorProperties"
                    accentColor="#04a6cb"
                    alignment="dorFieldVerticalAlignment"
                    fontFamily="Arial"
                    hidePanelDescriptions="true"
                    includeUnboundFields="true"
                    metaTemplateRef="{{ variables.meta_template_ref }}"
                    optionSeparator=", "
                    optionsNumberInHorizontalAlign="4"
                    showSelectedOptions="false">
                    <branding jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <masterpage0 jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <txtBankingRelationship jcr:primaryType="nt:unstructured"/>
                                    <ShowBankingRelationship jcr:primaryType="nt:unstructured" value="1"/>
                                    <Header jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <AF_LOGO_IMAGE jcr:lastModified="{Date}2025-01-01T00:00:00.000+01:00" jcr:lastModifiedBy="{{ author }}" jcr:primaryType="nt:unstructured" valueFrom="template"/>
                                            <FormType jcr:primaryType="nt:unstructured" resourceType="granite/ui/components/coral/foundation/form/textarea" value="{{ variables.form_type }}" valueFrom="     "/>
