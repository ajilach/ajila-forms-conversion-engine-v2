    <fd__x003c_p_x003e_Subject-2032087789
        jcr:mixinTypes="[sling:Message]"
        jcr:primaryType="nt:folder"
        sling:key="fd_&lt;p>Subject to mandatory jurisdictions provided by law the exclusive place of jurisdiction for all legal proceedings shall be Zurich or the location of the branch holding the account.&lt;/p>&#xa;"
        sling:message="&lt;p>Jurisdicción exclusivo para todos los procedimientos es Zúrich o el domicilio de la oficina que gestione la cuenta. Este también será, a la vez, el lugar de cumplimiento y, para clientes domiciliados en el extranjero, el lugar de ejecución.&lt;/p>&#xa;"/>
    <fd__x003c_p_x003e_This_x0020_po1145465036
        jcr:mixinTypes="[sling:Message]"
        jcr:primaryType="nt:folder"
        sling:key="fd_&lt;p>This power of attorney shall be governed by and construed in accordance with substantive Swiss law.&lt;/p>&#xa;"
        sling:message="&lt;p>El presente poder se somete al derecho material suizo.&lt;/p>&#xa;"/>
    <fd__x003c_p_x003e_This_x0020_sh-472846617
        jcr:mixinTypes="[sling:Message]"
        jcr:primaryType="nt:folder"
        sling:key="fd_&lt;p>This shall also be the place of performance, and the place of debt collection for clients domiciled abroad.&lt;/p>&#xa;"
        sling:message="&lt;p>Quedan exceptuadas las jurisdicciones que sean obligatorias por ley.&lt;/p>&#xa;"/>
